<?xml version="1.0" encoding="utf-8"?>
<!--
  MODÈLE — à recopier en « secrets.config » SUR LE SERVEUR UNIQUEMENT.

  secrets.config est exclu de Git (.gitignore). Il ne doit jamais être
  committé : c'est tout l'intérêt du dispositif.

  Mode d'emploi sur un hébergement mutualisé (pas d'accès ligne de commande) :
    1. recopier ce fichier sous le nom « secrets.config » ;
    2. y mettre les vraies valeurs ;
    3. le déposer par FTP à la racine du site, à côté de Web.config ;
    4. vérifier avec GET /sante → doit renvoyer "smtp":"configure".

  Les clés déclarées ici écrasent celles d'<appSettings> dans Web.config.
  Ne laissez dans ce fichier que les clés que vous renseignez réellement :
  une clé vide écraserait la valeur par défaut de Web.config.

  Si vous disposez d'un serveur dont vous maîtrisez l'environnement, préférez
  les variables CAMALERT_* (voir README.md) : elles ont la priorité sur ce
  fichier et ne laissent aucun secret sur le disque du site.

  ATTENTION : la racine de ce fichier est <appSettings>, PAS <configuration>.
-->
<appSettings>

  <!-- ─── Chaîne de connexion à la base ───────────────────────────────
       En production elle contient le mot de passe du compte SQL : c'est
       pour cela qu'elle est ici et non dans Web.config.
       Le nom de la clé est « ConnectionString_ » suivi du nom de la
       chaîne, soit CamAlertDB. -->
  <add key="ConnectionString_CamAlertDB"
       value="Server=VOTRE_SERVEUR;Database=CamAlert;User Id=VOTRE_COMPTE;Password=VOTRE_MOT_DE_PASSE;Encrypt=True;TrustServerCertificate=True;" />

  <!-- ─── Envoi des emails du formulaire de contact ───────────────────
       SMTP_Password n'est PAS le mot de passe du compte Gmail, mais un
       « mot de passe d'application » de 16 lettres généré sur
       https://myaccount.google.com/apppasswords (2FA obligatoire).

       Si vous recréez ce mot de passe après une fuite, pensez à révoquer
       l'ancien : le retirer du code ne le désactive pas. -->
  <add key="SMTP_User"     value="contact@exemple.cm" />
  <add key="SMTP_Password" value="xxxxxxxxxxxxxxxx" />
  <add key="SMTP_From"     value="contact@exemple.cm" />

  <!-- Destinataires des messages de contact, séparés par des
       points-virgules. -->
  <add key="Contact_Destinataires" value="agent1@exemple.cm;agent2@exemple.cm" />

</appSettings>
