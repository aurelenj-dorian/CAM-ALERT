<?xml version="1.0" encoding="utf-8"?>
<!--
  Pour plus d'informations sur la configuration de votre application ASP.NET,
  visitez https://go.microsoft.com/fwlink/?LinkId=169433

  ───────────────────────────────────────────────────────────────────────────
  SECRETS : ce fichier est versionné dans un dépôt PUBLIC.
  N'y écrivez aucun mot de passe, aucune clé, aucun jeton.

  Les valeurs sensibles sont lues par CamAlert.Helpers.Parametres, qui consulte
  d'abord les variables d'environnement du serveur :

      setx CAMALERT_SMTP_PASSWORD "<mot de passe d'application>"            /M
      setx CAMALERT_SMTP_USER     "<compte expediteur>"                     /M
      setx CAMALERT_CONNECTIONSTRING_CamAlertDB "Server=.;Database=CamAlert;..." /M

  Puis redémarrez le pool d'applications IIS pour qu'il relise l'environnement.
  Voir SECURITY.md : le mot de passe d'application Gmail qui figurait dans
  Contact.aspx.cs a été publié avec ce dépôt et doit être révoqué.
  ───────────────────────────────────────────────────────────────────────────
  -->
<configuration>
	<connectionStrings>
		<!-- Valeur de développement. En production, définir plutôt la variable
		     d'environnement CAMALERT_CONNECTIONSTRING_CamAlertDB : elle a la
		     priorité et évite d'exposer un nom de serveur dans Git. -->
		<add name="CamAlertDB"
             connectionString="Data Source=.;Initial Catalog=CamAlert;Integrated Security=True;"
             providerName="System.Data.SqlClient" />
	</connectionStrings>

	<appSettings>
		<add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />

		<!-- Envoi des messages du formulaire de contact.
		     SMTP_Password n'est PAS le mot de passe du compte Gmail, mais un
		     « mot de passe d'application » de 16 lettres généré sur
		     https://myaccount.google.com/apppasswords (2FA obligatoire).
		     Il doit rester hors de ce fichier : renseignez la variable
		     d'environnement CAMALERT_SMTP_PASSWORD. -->
		<add key="SMTP_Host" value="smtp.gmail.com" />
		<add key="SMTP_Port" value="587" />
		<add key="SMTP_SSL" value="true" />
		<add key="SMTP_User" value="A_DEFINIR" />
		<add key="SMTP_Password" value="A_DEFINIR_VARIABLE_ENVIRONNEMENT" />
		<add key="SMTP_From" value="A_DEFINIR" />
		<add key="SMTP_NomExp" value="CAM-ALERT — Portail camerounais" />

		<!-- Destinataires des messages de contact, séparés par des
		     points-virgules. Ces quatre adresses étaient codées en dur dans
		     Contact.aspx.cs. -->
		<add key="Contact_Destinataires" value="A_DEFINIR" />
	</appSettings>

	<system.web>
		<compilation debug="true" targetFramework="4.8" />
		<httpRuntime targetFramework="4.8"
		             enableVersionHeader="false"
		             maxRequestLength="8192"
		             requestValidationMode="4.5" />

		<!-- L'application gère l'authentification elle-même (session +
		     PageAdmin) : aucun module d'authentification intégré ne doit
		     s'interposer. -->
		<authentication mode="None" />

		<!-- Pages d'erreur neutres. redirectMode="ResponseRewrite" conserve le
		     contexte de la requête, donc la référence d'incident posée par
		     Application_Error ; une redirection classique la perdrait. -->
		<customErrors mode="RemoteOnly" redirectMode="ResponseRewrite"
		              defaultRedirect="~/Erreur.aspx">
			<error statusCode="403" redirect="~/Introuvable.aspx" />
			<error statusCode="404" redirect="~/Introuvable.aspx" />
			<error statusCode="500" redirect="~/Erreur.aspx" />
		</customErrors>

		<!-- Cookies inaccessibles au JavaScript. requireSSL est activé par la
		     transformation Release pour ne pas casser le développement en
		     HTTP simple. -->
		<httpCookies httpOnlyCookies="true" requireSSL="false" sameSite="Lax" />

		<!-- Session par cookie uniquement : un identifiant de session dans
		     l'URL fuirait par l'en-tête Referer et les journaux de proxy. -->
		<sessionState mode="InProc" cookieless="UseCookies" timeout="30" />

		<!-- Les mots de passe sont hachés en PBKDF2 (Helpers/HacheurMotDePasse.cs),
		     mais le ViewState et les jetons anti-CSRF sont signés avec la clé
		     machine. En production, fixer une clé générée sur le serveur, sinon
		     chaque recyclage du pool invalide les formulaires ouverts :
		     <machineKey validationKey="..." decryptionKey="..."
		                 validation="HMACSHA256" decryption="AES" /> -->

		<pages enableViewStateMac="true" viewStateEncryptionMode="Auto" />
	</system.web>

	<system.webServer>
		<!-- Pas de listage de répertoires : /Uploads/ et /Admin/image/
		     contiennent des pièces jointes de signalements. -->
		<directoryBrowse enabled="false" />

		<httpProtocol>
			<customHeaders>
				<!-- Ne pas annoncer la pile technique -->
				<remove name="X-Powered-By" />

				<!-- Empêche le navigateur de « deviner » un autre type de
				     contenu : une pièce jointe interprétée comme du script. -->
				<add name="X-Content-Type-Options" value="nosniff" />

				<!-- Interdit l'affichage du site dans une iframe tierce
				     (clickjacking sur les formulaires d'administration). -->
				<add name="X-Frame-Options" value="SAMEORIGIN" />

				<add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
				<add name="Permissions-Policy"
				     value="geolocation=(), camera=(), microphone=()" />

				<!-- Politique de sécurité du contenu.
				     'unsafe-inline' reste nécessaire : les pages portent de
				     nombreux styles et gestionnaires d'événements en ligne.
				     Les retirer suppose d'extraire ce code dans des fichiers
				     .js/.css ; la liste blanche d'origines limite déjà
				     fortement l'injection. unpkg.com sert Leaflet, et les
				     tuiles de la carte viennent d'OpenStreetMap. -->
				<add name="Content-Security-Policy"
				     value="default-src 'self'; script-src 'self' 'unsafe-inline' https://unpkg.com; style-src 'self' 'unsafe-inline' https://unpkg.com; font-src 'self' data:; img-src 'self' data: https://unpkg.com https://*.tile.openstreetmap.org; connect-src 'self'; worker-src 'self'; manifest-src 'self'; frame-ancestors 'self'; form-action 'self'; base-uri 'self'; object-src 'none'" />
			</customHeaders>
		</httpProtocol>

		<security>
			<requestFiltering>
				<!-- 8 Mo : aligné sur maxRequestLength, et sur la limite de
				     8 Mo des pièces jointes (FichierSecurise). -->
				<requestLimits maxAllowedContentLength="8388608" />
				<hiddenSegments>
					<add segment="App_Data" />
					<add segment="Database" />
				</hiddenSegments>
			</requestFiltering>
		</security>

		<handlers>
			<!-- Point de contrôle d'état : GET /sante -->
			<add name="Sante" path="sante" verb="GET"
			     type="CamAlert.Handlers.SanteHandler, CamAlert"
			     preCondition="integratedMode" />
		</handlers>

	</system.webServer>

	<!-- Les dossiers de fichiers déposés ne servent que des images et des PDF.
	     Un fichier .aspx ou .asp qui y serait déposé malgré les contrôles de
	     FichierSecurise renverrait 404 au lieu d'être exécuté.

	     On filtre les extensions plutôt que de vider la liste des
	     gestionnaires pour ce chemin : un <clear/> sur <handlers> y
	     désactiverait aussi la compression statique, les documents par défaut
	     et la gestion du cache. Ici, seule la liste des extensions servies
	     change. -->
	<location path="Uploads">
		<system.webServer>
			<security>
				<requestFiltering>
					<fileExtensions allowUnlisted="false">
						<add fileExtension=".jpg"  allowed="true" />
						<add fileExtension=".jpeg" allowed="true" />
						<add fileExtension=".png"  allowed="true" />
						<add fileExtension=".webp" allowed="true" />
						<add fileExtension=".pdf"  allowed="true" />
					</fileExtensions>
				</requestFiltering>
			</security>
		</system.webServer>
	</location>

	<location path="Admin/image">
		<system.webServer>
			<security>
				<requestFiltering>
					<fileExtensions allowUnlisted="false">
						<add fileExtension=".jpg"  allowed="true" />
						<add fileExtension=".jpeg" allowed="true" />
						<add fileExtension=".png"  allowed="true" />
						<add fileExtension=".webp" allowed="true" />
					</fileExtensions>
				</requestFiltering>
			</security>
		</system.webServer>
	</location>

	<system.codedom>
		<compilers>
			<compiler language="c#;cs;csharp" extension=".cs" type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.CSharpCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=2.0.1.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" warningLevel="4" compilerOptions="/langversion:default /nowarn:1659;1699;1701" />
			<compiler language="vb;vbs;visualbasic;vbscript" extension=".vb" type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.VBCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=2.0.1.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" warningLevel="4" compilerOptions="/langversion:default /nowarn:41008 /define:_MYTYPE=\&quot;Web\&quot; /optionInfer+" />
		</compilers>
	</system.codedom>
</configuration>
