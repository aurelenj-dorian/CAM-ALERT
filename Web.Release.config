<?xml version="1.0" encoding="utf-8"?>

<!-- Transformation appliquée à la publication en configuration Release.
     Voir https://go.microsoft.com/fwlink/?LinkId=125889

     Objectif : durcir ce qui doit rester permissif en développement.
       • debug="false"           → pas de symboles ni de traces détaillées ;
       • customErrors mode="On"  → même page neutre pour le poste local et le
                                   réseau, donc aucune fuite de pile d'appels ;
       • requireSSL / HSTS       → cookies et connexions en HTTPS seulement.

     Les secrets (mot de passe SMTP, chaîne de connexion) ne sont PAS injectés
     ici : ce fichier est versionné. Ils viennent des variables d'environnement
     du serveur, lues par CamAlert.Helpers.Parametres. -->

<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">

  <system.web>
    <compilation xdt:Transform="RemoveAttributes(debug)" />

    <customErrors mode="On" redirectMode="ResponseRewrite"
                  defaultRedirect="~/Erreur.aspx" xdt:Transform="Replace">
      <error statusCode="403" redirect="~/Introuvable.aspx" />
      <error statusCode="404" redirect="~/Introuvable.aspx" />
      <error statusCode="500" redirect="~/Erreur.aspx" />
    </customErrors>

    <httpCookies httpOnlyCookies="true" requireSSL="true" sameSite="Lax"
                 xdt:Transform="Replace" />
  </system.web>

  <system.webServer>
    <httpProtocol>
      <customHeaders>
        <!-- HSTS : le navigateur refusera toute connexion en clair pendant un
             an. À n'activer qu'une fois le certificat en place sur le domaine. -->
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains"
             xdt:Transform="Insert" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>

</configuration>
